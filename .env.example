# Somente a chave pública do projeto. Nunca use sb_secret ou service_role aqui.
VITE_SUPABASE_URL=https://rbuscpwntzpyqsuycqmv.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# MCP Agrisul: mantenha desativado até a aprovação de OAuth, migração e teste real.
# Estas variáveis são configuração do servidor. Não use VITE_ para valores privados.
AGRISUL_MCP_ENABLED=false
AGRISUL_MCP_RESOURCE=
AGRISUL_MCP_OAUTH_CLIENT_ID=

# Segundo cliente OAuth confidencial, separado do bearer recebido no MCP.
# A URL do cofre usa um LOGIN futuro restrito, membro somente de
# agrisul_mcp_vault; não use postgres, service_role ou credencial do pooler admin.
# A chave v1 é 32 bytes codificados em base64url. Configure somente após a
# aprovação e migração, no ambiente seguro do servidor.
AGRISUL_MCP_UPSTREAM_CLIENT_ID=
AGRISUL_MCP_UPSTREAM_CLIENT_SECRET=
AGRISUL_MCP_VAULT_DATABASE_URL=
AGRISUL_MCP_VAULT_KEY_V1=
